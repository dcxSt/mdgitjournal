{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdgitjournal",
  "version": "0.1.0",
  "identifier": "xyz.stephenfay.mdgitjournal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdgitjournal",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc:",
        "img-src": "'self' asset:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/journal/assets/**", "$DOCUMENT/journal/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "A minimal markdown journal synced with git",
    "longDescription": "mdgitjournal is a small, fast markdown journal for macOS, Linux and iPhone. Every entry is a plain .md file in an ordinary git repository, with built-in history that works offline and without an account. Optionally connect one GitHub repository to sync between devices with explicit Pull and Commit & Push.",
    "copyright": "© 2026 Stephen Fay",
    "license": "MIT",
    "homepage": "https://mdgitjournal.stephenfay.xyz",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
